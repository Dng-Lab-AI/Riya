# Adresse de votre base MongoDB (Atlas : Connect > Drivers), terminée par /riya
MONGODB_URI=mongodb+srv://utilisateur:motdepasse@cluster0.xxxxx.mongodb.net/riya

# Optionnel : serveur TURN pour les réseaux restrictifs (classe vidéo)
# TURN_URLS=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Optionnel : IA OpenAI (ChatGPT) pour le résumé des cours, l'assistant en classe et les quiz
# Clé à créer sur platform.openai.com > API keys
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.5

# Paiement en ligne (Flutterwave : MTN / Orange Money en FCFA, mobile money, cartes)
# Sans clé, une caisse de démonstration (faux paiement toujours validé) remplace Flutterwave,
# en développement comme en production. Mettez DEMO_PAYMENTS=off en production pour la désactiver.
# Clés : dashboard Flutterwave > Settings > API keys. Webhook : Settings > Webhooks,
# URL https://votre-site/api/paiements/flutterwave et le même « secret hash » qu'ici.
# FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-...
# FLUTTERWAVE_WEBHOOK_HASH=une-longue-phrase-secrete
# Adresse publique du site, pour le retour après paiement
# SITE_URL=https://riya.africa
# Part gardée par Riya sur chaque cours (0.15 = 15 %)
# RIYA_COMMISSION=0.15
# Taux de change depuis l'euro pour les devises non liées à l'euro (FCFA et euro n'en ont pas besoin).
# Sans taux, ces pays paient par carte en euros.
# PAYMENT_FX_RATES={"NGN":1650,"GHS":16,"KES":140,"UGX":4000,"RWF":1500,"TZS":2800,"ZAR":20,"CDF":3000}

# E-mails (confirmation d'adresse, mot de passe oublié) via Resend : resend.com > API Keys.
# Avec l'expéditeur de test onboarding@resend.dev, Resend n'envoie qu'à l'adresse de votre compte :
# vérifiez votre domaine (resend.com > Domains) pour écrire à tous les utilisateurs.
# Sans clé en développement, les liens sont affichés dans le terminal de « npm run dev ».
# RESEND_API_KEY=re_...
# MAIL_FROM=Riya <no-reply@votre-domaine.com>
#
# Ou bien n'importe quel serveur SMTP (Brevo, Mailgun, Gmail…), utilisé si RESEND_API_KEY est vide :
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Connexion avec Google : console.cloud.google.com > API et services > Identifiants >
# « ID client OAuth » (application Web), URI de redirection autorisée :
# https://votre-site/api/auth/google/callback (et http://localhost:3000/api/auth/google/callback en local)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
